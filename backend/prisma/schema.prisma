generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo inicial.
// Lo completaremos con las entidades reales del sistema antes de crear migraciones.
model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  cargo     String?
  codigoSiss String  @unique
  carnet    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
